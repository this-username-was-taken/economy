{
	"schemaVersion": 1,
	"id": "isometrycraft",
	"version": "${version}",
	"name": "IsometryCraft",
	"description": "Experience Minecraft from a true isometric perspective.",
	"authors": [
		"Bryce3345"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/isometrycraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.bryce.IsometryCraft"
		],
		"client": [
			"com.bryce.client.IsometryCraftClient"
		],
		"fabric-datagen": [
			"com.bryce.client.IsometryCraftDataGenerator"
		]
	},
	"mixins": [
		"isometrycraft.mixins.json",
		{
			"config": "isometrycraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}
